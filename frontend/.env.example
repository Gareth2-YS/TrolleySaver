# Accepted values: mock | cognito
# Use mock for the current local dummy-login flow.
VITE_AUTH_MODE=mock

# The settings below are only needed when VITE_AUTH_MODE=cognito.
# Example: ap-southeast-1
VITE_AWS_REGION=

# Example: ap-southeast-1_AbCdEf123
VITE_COGNITO_USER_POOL_ID=

# Use a public Cognito app client without a client secret.
VITE_COGNITO_CLIENT_ID=

# Optional until the backend API is connected. Example: http://localhost:3000
VITE_API_BASE_URL=
