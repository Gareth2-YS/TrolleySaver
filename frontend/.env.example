# Accepted values: mock | cognito
# Use mock for the current local dummy-login flow.
VITE_AUTH_MODE=mock

# Accepted values: local | api
# Local stores submission metadata in this browser and uses temporary object URLs for images.
# API mode is an explicit unimplemented integration point until the backend contract is connected.
VITE_PRICE_SUBMISSION_MODE=local

# Accepted values: local | api
# Local compares the basket in this browser against development-only prices from data/products 241026.xlsx.
# API mode calls GET /products, GET /retailers and POST /basket/compare on VITE_API_BASE_URL.
VITE_SMART_BASKET_MODE=local

# The settings below are only needed when VITE_AUTH_MODE=cognito.
# Example: ap-southeast-1
VITE_AWS_REGION=

# Example: ap-southeast-1_AbCdEf123
VITE_COGNITO_USER_POOL_ID=

# Use a public Cognito app client without a client secret.
VITE_COGNITO_CLIENT_ID=

# Optional until the backend API is connected. Example: http://localhost:3000
VITE_API_BASE_URL=
